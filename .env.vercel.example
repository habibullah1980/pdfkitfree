# ==============================================================================
# pdfkitfree — Environment Variables Template (Vercel & Supabase Deployment)
# ==============================================================================
# Instructions:
# - Add these variables to your Vercel Project Settings > Environment Variables
# - For Supabase, obtain credentials from Project Settings > API and Database
# - Never commit real values to Git
# ==============================================================================

# --- 1. Core Domain & Environment ---
NODE_ENV=
NEXT_TELEMETRY_DISABLED=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_DOMAIN=

# --- 2. Session & Auth Security ---
# Generate with: openssl rand -hex 32
AUTH_SECRET=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# --- 3. Supabase Integration ---
# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase Anon Public Key (Safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase Service Role Key (Keep strictly server-side, never NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
# Direct PostgreSQL connection string from Supabase (Session / Transaction Pooler)
DATABASE_URL=
DIRECT_URL=

# --- 4. Payment Gateways (Stripe & PayPal) ---
# Stripe Checkout & Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# PayPal Credentials & Webhooks
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=
PAYMENT_WEBHOOK_SECRET=

# --- 5. Transactional Email & SMS OTP Delivery ---
# Email Delivery ('mock_console' | 'resend' | 'sendgrid' | 'smtp')
EMAIL_PROVIDER=
RESEND_API_KEY=
FROM_EMAIL=
# SMS Phone OTP ('mock_console' | 'twilio')
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- 6. AI Document Assistant (OpenAI / Compatible Provider) ---
# AI Provider ('mock_local' | 'openai' | 'anthropic' | 'google')
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_MAX_TOKENS=
