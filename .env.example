# ==============================================================================
# pdfkitfree — Production Environment Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env on your VPS: `cp .env.example .env`
# 2. Generate strong secrets using `openssl rand -hex 32`
# 3. Replace placeholder values with your verified credentials
# 4. Never commit your production .env file to public version control
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & CANONICAL DOMAIN
# ------------------------------------------------------------------------------
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PORT=3000

# Canonical domain configuration (Used for OpenGraph, sitemap.xml, robots.txt, metadataBase)
NEXT_PUBLIC_APP_URL=https://www.pdfkitfree.online
NEXT_PUBLIC_DOMAIN=pdfkitfree.online

# Mandatory session encryption secret (Min 32 characters, e.g. openssl rand -hex 32)
AUTH_SECRET=your_high_entropy_32_character_auth_secret_here

# Initial Super Admin credentials for management console
SUPERADMIN_EMAIL=habibullah
SUPERADMIN_PASSWORD=change_this_to_a_secure_production_password

# Persistent storage configuration within container
DATA_DIR=/app/.data
DB_FILE=/app/.data/freepdfkit-db.json

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
POSTGRES_USER=pdfkituser
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_DB=pdfkitdb
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pdfkituser:your_strong_postgres_password_here@postgres:5432/pdfkitdb?sslmode=disable

# ------------------------------------------------------------------------------
# 3. PAYMENT GATEWAYS (STRIPE & PAYPAL)
# Note: Keep in test mode (sk_test_... / PAYPAL_ENV=sandbox) until credentials verified
# ------------------------------------------------------------------------------
# Stripe Checkout
STRIPE_SECRET_KEY=sk_test_replace_with_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_replace_with_stripe_webhook_secret

# PayPal
PAYPAL_CLIENT_ID=replace_with_paypal_client_id
PAYPAL_CLIENT_SECRET=replace_with_paypal_client_secret
PAYPAL_WEBHOOK_ID=replace_with_paypal_webhook_id
# Mode: "sandbox" for staging/testing, "live" for production transactions
PAYPAL_ENV=sandbox

# Fallback payment webhook secret
PAYMENT_WEBHOOK_SECRET=your_strong_payment_webhook_hmac_secret

# ------------------------------------------------------------------------------
# 4. EMAIL & SMS NOTIFICATION PROVIDERS
# Note: Defaults to mock_console (safe sandbox). Switch to resend/twilio when ready.
# ------------------------------------------------------------------------------
# Email: 'mock_console' | 'resend' | 'sendgrid' | 'smtp'
EMAIL_PROVIDER=mock_console
RESEND_API_KEY=re_replace_with_resend_api_key
FROM_EMAIL="PDFKitFree <noreply@pdfkitfree.online>"
# Destination inbox for /contact form inquiries (forwarded to your email)
SUPPORT_RECIPIENT_EMAIL=support@pdfkitfree.online

# SMS OTP: 'mock_console' | 'twilio'
SMS_PROVIDER=mock_console
TWILIO_ACCOUNT_SID=AC_replace_with_twilio_account_sid
TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# ------------------------------------------------------------------------------
# 5. AI DOCUMENT ASSISTANT (OPENAI / COMPATIBLE LLM)
# Note: Defaults to mock_local (built-in knowledge engine, zero API charges)
# ------------------------------------------------------------------------------
# Provider: 'mock_local' | 'openai' | 'anthropic' | 'google'
AI_PROVIDER=mock_local
AI_API_KEY=sk-replace_with_openai_api_key
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2000
